# Ignore everything in the root by default.
# New root entries must be explicitly added with `git add -f`
# New root directories must be explicitly listed below
/*

# Top level dirs
!/.github
!/Sources
!/axDumps
!/dev-docs
!/legal
!/resources
!/script

# Top level important files
!/*.sh
!/.editorconfig
!/.gitignore
!/CONTRIBUTING.md
!/CONTEXT.md
!/Package.resolved
!/Package.swift
!/README.md
!/LICENSE.txt
!/.swift-version
!/.swift-format
!/makefile

# Xcode user settings
xcuserdata/
xcshareddata/
